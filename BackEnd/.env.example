# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (choose the Singapore region for the cluster)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tan-sac-ven-huong?retryWrites=true&w=majority

# PayOS Payment Gateway Credentials (Get these free from https://my.payos.vn)
PAYOS_CLIENT_ID=your_client_id_here
PAYOS_API_KEY=your_api_key_here
PAYOS_CHECKSUM_KEY=your_checksum_key_here

# Allow the 2,000 VND payment test switch in production only when explicitly enabled
PAYMENT_TEST_MODE_ENABLED=false

